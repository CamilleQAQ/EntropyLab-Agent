{
  "format": "entropylab.dataset-spec",
  "format_version": 1,
  "dataset_id": "GEAR_5STATE_TSMEFUDE_BTLSSVM",
  "sampling_rate_hz": 15360,
  "input": {
    "channel": 0,
    "key": null,
    "sample_axis": -1,
    "indices": [],
    "has_header": false,
    "delimiter": ",",
    "skip_rows": 0
  },
  "layout": {
    "loader": "npy_tensor",
    "file_pattern": "**/*.npy",
    "manifest": null,
    "label_source": "parent",
    "group_source": "file",
    "group_regex": null,
    "packed_files": [
      {"path": "class1.npy", "label": "HEALTHY"},
      {"path": "class2.npy", "label": "CRACK"},
      {"path": "class3.npy", "label": "WEAR"},
      {"path": "class4.npy", "label": "MISSING_TOOTH"},
      {"path": "class5.npy", "label": "SPALLING"}
    ],
    "record_axis": 0,
    "channel_axis": 1,
    "sample_axis": 2,
    "group_size": 6
  },
  "labels": {
    "names": ["HEALTHY", "CRACK", "WEAR", "MISSING_TOOTH", "SPALLING"],
    "mapping": {
      "HEALTHY": 0,
      "CRACK": 1,
      "WEAR": 2,
      "MISSING_TOOTH": 3,
      "SPALLING": 4
    },
    "healthy_class_id": 0
  },
  "window": {"size": 2000, "stride": 2000, "windows_per_record": 1},
  "preprocessing": "NONE",
  "feature": {
    "method": "TSMEFuDE",
    "parameters": {"m": 2, "nc": 5, "tau": 1, "kmax": 20}
  },
  "classifier": {
    "algorithm": "BT-LSTSVM",
    "backend": "torch",
    "parameters": {"c1": 1.0, "c2": 1.0, "bandwidth": 1.0, "epsilon": 0.0001}
  },
  "split": {
    "mode": "random",
    "seed": 20261104,
    "train_fraction": 0.6,
    "validation_fraction": 0.2
  },
  "ood": {"calibration": "DISABLED", "margin": 1.05},
  "diagnosis": {
    "profile_id": "GEAR_5STATE",
    "display_name": "Herringbone gear 5-state, TSMEFuDE + BT-LSTSVM",
    "workflow": "MODEL_ARTIFACT_DIAGNOSIS",
    "signal_type": "ACCELERATION",
    "signal_role": "GEARBOX_VIBRATION_CHANNEL_1",
    "sampling_rate_tolerance_hz": 0,
    "minimum_window_count": 1,
    "evidence_window_count": 1,
    "validation_scope": "random file-group-isolated holdout on the herringbone-gear 5-state protocol",
    "experimental": true
  }
}
